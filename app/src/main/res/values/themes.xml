<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.LearnApplication" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorStatusBar</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColor">@color/dark_grey</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="backgroundColor">@color/white</item>
        <item name="colorButtonPress">@color/colorPrimary</item>
        <item name="colorButtonUnpressed">@color/colorUnpressedBtnLight</item>
        <item name="colorButtonMenu">@color/white</item>
        <item name="colorCornerBackground">@drawable/corner_background</item>
        <item name="elevation">1dp</item>

    </style>

    <style name="Theme.LearnApplication" parent="Base.Theme.LearnApplication" />

    <style name="Widget.App.FAB.DetailsFragment.Favorite" parent="Widget.MaterialComponents.ExtendedFloatingActionButton">
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="android:backgroundTint">?attr/backgroundColor</item>
        <item name="iconTint">?attr/colorPrimary</item>

    </style>

    <style name="Widget.App.FAB.DetailsFragment" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">?backgroundColor</item>
        <item name="tint">?colorButtonPress</item>

    </style>

    <style name="Theme.LearnApplication.PopupOverlay" parent="@style/Widget.MaterialComponents.Toolbar.Primary">
        <item name="menu">@menu/toolbar_menu</item>
        <item name="title">@string/app_bar_title</item>
        <item name="navigationIcon">@drawable/ic_round_menu</item>
        <item name="titleTextColor">@color/white</item>
        <item name="android:background">@color/colorToolbarLight</item>

    </style>

    <style name="my_b_nav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemTextAppearanceActive">@style/TextAppearance.AppCompat</item>

    </style>

    <style name="AlertDialogColorTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <!-- Цвет фона -->
        <item name="colorSurface">@color/white</item>
        <!-- Цвет текста -->
        <item name="colorOnSurface">@color/black</item>

    </style>

    <style name="bottom_poster_clickable">
        <item name="android:layout_width">150dp</item>
        <item name="android:layout_height">225dp</item>
        <item name="android:layout_margin">10dp</item>
        <item name="cardCornerRadius">15dp</item>
        <item name="android:clickable">true</item>
        <item name="android:stateListAnimator">@animator/p_press_anim</item>

    </style>


</resources>