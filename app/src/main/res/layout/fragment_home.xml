<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/backgroundColor"
    tools:context=".ui.home.HomeFragment">

    <!-- 1. AppBarLayout управляет поведением сворачивания -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/backgroundColor"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_home"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            style="@style/Theme.LearnApplication.PopupOverlay"
            app:layout_scrollFlags="scroll|enterAlways|snap">

            <EditText
                android:id="@+id/search_edit_text"
                android:layout_width="match_parent"
                android:drawablePadding="0dp"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingHorizontal="0dp"
                android:singleLine="true"
                style="@style/MySearchField" />

        </com.google.android.material.appbar.MaterialToolbar>

        <!-- 2. Переносим top_holder внутрь AppBarLayout, чтобы он тоже скрывался при скролле -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/top_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/corner_background"
            app:layout_scrollFlags="scroll|enterAlways|snap"
            app:layout_constraintTop_toBottomOf="@id/toolbar_home">

            <androidx.cardview.widget.CardView
                android:id="@+id/top_container"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_margin="10dp"
                android:elevation="5dp"
                app:cardCornerRadius="15dp"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imageView"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:scaleType="centerCrop"
                        app:srcCompat="@drawable/p_1" />

                    <ImageView
                        android:id="@+id/imageView2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scaleType="centerCrop"
                        app:srcCompat="@drawable/p_2" />

                    <ImageView
                        android:id="@+id/imageView3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1 "
                        android:scaleType="centerCrop"
                        app:srcCompat="@drawable/p_3" />

                    <ImageView
                        android:id="@+id/imageView4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scaleType="centerCrop"
                        app:srcCompat="@drawable/p_4" />
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/disclaimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:autoLink="web"
                android:linksClickable="true"
                android:text="@string/disclaimer"
                android:textColor="?android:attr/textColor"
                android:textColorLink="@android:color/holo_blue_dark"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/top_container" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- 3. RecyclerView теперь прямой потомок CoordinatorLayout и использует scrolling_view_behavior -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/main_recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/film_item" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>